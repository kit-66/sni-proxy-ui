# Почта для Let's Encrypt (обязательно)
ACME_EMAIL=your@email.com

# Привязка порта UI: 127.0.0.1 (только локально) или 0.0.0.0 (снаружи)
UI_PORT_BIND=127.0.0.1

# Часовой пояс
TZ=Europe/Yekaterinburg

# --- Пресеты портов панели 3x-ui (кнопки в UI) ---
# Хост бэкенда, который подставляется по клику на пресет:
XUI_HOST=3xui_app
# Список портов через запятую (пусто = встроенный набор 2083,2087,2096,2053,8443):
#XUI_PORTS=2083,2087,2096,2053,8443

# --- Ручной пароль UI (опционально) ---
# Если задать ОБЕ переменные — автогенерация отключается, файл data/ui-auth не используется.
# Раскомментируй, если хочешь свой пароль:
#UI_USER=admin
#SNI_UI_PASSWORD=твой_сложный_пароль
